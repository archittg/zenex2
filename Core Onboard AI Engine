import os
from ultralytics import YOLO

def run_onboard_inference(image_path, model_path="yolov8n.pt"):
    """
    Simulates on-orbit satellite image processing using a lightweight YOLO model.
    """
    if not os.path.exists(model_path):
        raise FileNotFoundError(f"Model weights file '{model_path}' not found locally.")
    
    if not os.path.exists(image_path):
        raise FileNotFoundError(f"Target image '{image_path}' not found.")

    print(f"[*] Initializing onboard AI model: {model_path}")
    model = YOLO(model_path)

    print(f"[*] Executing edge inference on capture: {image_path}")
    # imgsz=640 optimizes memory usage for constrained satellite hardware environments
    results = model.predict(source=image_path, imgsz=640, conf=0.25, verbose=False)
    
    return results[0]

if __name__ == "__main__":
    # Test execution with a sample local or online image
    sample_img = "https://ultralytics.com/images/bus.jpg"
    detections = run_onboard_inference(sample_img)
    print(f"[+] Inference complete. Objects detected: {len(detections.boxes)}")

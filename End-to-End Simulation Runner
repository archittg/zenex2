import time
import os
from satellite_inference import run_onboard_inference
from metadata_formatter import generate_lightweight_metadata

def simulate_satellite_telemetry_pipeline(image_path):
    """
    Simulates the full transmission lifecycle: Capture -> AI Inference -> Metadata Extraction -> Bandwidth Savings
    """
    print("==================================================")
    print(" SATELLITE EDGE-AI DOWNLINK SIMULATOR INITIALIZED ")
    print("==================================================")
    
    start_time = time.time()
    
    # Step 1: Run On-board AI
    results = run_onboard_inference(image_path)
    
    # Step 2: Extract structured text payload
    json_path = generate_lightweight_metadata(results)
    
    end_time = time.time()
    processing_latency = end_time - start_time
    
    # Step 3: Compute bandwidth optimization metrics
    # Note: If passing an online URL path or local file, safely estimate sizes
    raw_size_bytes = 2500000  # Simulated typical 2.5MB high-res raw optical tile frame
    metadata_size_bytes = os.path.getsize(json_path)
    
    bandwidth_saved_percent = ((raw_size_bytes - metadata_size_bytes) / raw_size_bytes) * 100

    print("\n--- DOWNLINK TELEMETRY REPORT ---")
    print(f"Processing Latency   : {processing_latency:.4f} seconds")
    print(f"Raw Image Footprint  : ~{raw_size_bytes / 1024:.2f} KB")
    print(f"Metadata Payload Size: {metadata_size_bytes} bytes")
    print(f"Bandwidth Efficiency : {bandwidth_saved_percent:.2f}% reduction achieved")
    print("--------------------------------------------------")

if __name__ == "__main__":
    # Run the comprehensive loop simulation
    simulate_satellite_telemetry_pipeline("https://ultralytics.com/images/bus.jpg")
